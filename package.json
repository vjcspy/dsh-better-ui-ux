{
  "name": "dsh-better-ui-ux",
  "version": "0.1.1",
  "private": true,
  "description": "DSH Web plugin that shows the effective provider/model route badge in the session header for the main Session and every subagent child.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "web",
    "model",
    "badge",
    "session-header"
  ],
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json && tsdown --config tsdown.config.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm run build && vitest run",
    "test:client": "vitest run test/client"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-projection": "link:../deepseek-harness/packages/session/session-projection",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-api-session-controller": "link:../deepseek-harness/packages/api/session-controller",
    "@deepseek-ai/dsh-client-locale": "link:../deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-session": "link:../deepseek-harness/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "link:../deepseek-harness/packages/client/ui-sidebar-right",
    "@deepseek-ai/dsh-client-ui-slots": "link:../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-llm": "link:../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-subagent": "link:../deepseek-harness/packages/subagent/subagent",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "link:../deepseek-harness/node_modules/tsdown",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  }
}
